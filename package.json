{
  "name": "svgedit-fork",
  "version": "7.4.1-fork.10",
  "private": true,
  "description": "Powerful SVG-Editor for your browser ",
  "main": "dist/editor/Editor.js",
  "module": "dist/editor/Editor.js",
  "exports": {
    ".": "./dist/editor/Editor.js",
    "./*": "./*"
  },
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/svgcanvas"
  ],
  "scripts": {
    "lint": "eslint .",
    "check-dom-scope": "node scripts/check-dom-scope.mjs",
    "check-layers": "node scripts/check-layers.mjs",
    "file-map": "node scripts/file-map.mjs",
    "bundle-report": "node scripts/bundle-report.mjs",
    "bundle-size": "node scripts/bundle-report.mjs --check",
    "check-file-map": "node scripts/file-map.mjs --check",
    "check-canvas-calls": "node scripts/check-canvas-calls.mjs",
    "check-editor-strict": "node scripts/check-editor-strict.mjs",
    "gen-ui-ids": "node scripts/gen-ui-ids.mjs",
    "typecheck": "tsc -p packages/svgcanvas/tsconfig.json && tsc -p packages/svgcanvas/tsconfig.strict.json && tsc -p src/editor/tsconfig.hostapi.json",
    "pretest": "npm run lint && npm run check-dom-scope && npm run check-layers && npm run check-ts-imports && npm run check-file-map && npm run typecheck && npm run check-canvas-calls && npm run check-editor-strict",
    "test": "vitest run --coverage && node scripts/run-e2e.mjs",
    "build": "vite build",
    "postbuild": "node scripts/copy-static.mjs",
    "start": "vite dev --host --port 8000 --strictPort",
    "prestart": "echo svgedit is available at http://localhost:8000/src/editor/index.html",
    "start:e2e": "vite preview --host --port 8000 --strictPort --outDir dist/editor",
    "version-bump": "node scripts/version-bump.mjs",
    "publish": "node scripts/publish.mjs",
    "test-build": "npm test && npm run build",
    "check-ts-imports": "node scripts/check-ts-imports.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idanariav/svgedit.git"
  },
  "keywords": [
    "svg-editor",
    "javascript",
    "svg-edit",
    "svg"
  ],
  "author": "Narendra Sisodiya",
  "contributors": [
    "Pavol Rusnak",
    "Jeff Schiller",
    "Vidar Hokstad",
    "Alexis Deveria",
    "Brett Zamir",
    "Fabien Jacq",
    "OptimistikSAS"
  ],
  "license": "(MIT AND Apache-2.0 AND ISC AND LGPL-3.0-or-later AND X11)",
  "bugs": {
    "url": "https://github.com/idanariav/svgedit/issues"
  },
  "homepage": "https://github.com/idanariav/svgedit#readme",
  "browserslist": [
    "defaults",
    "not IE 11",
    "not OperaMini all"
  ],
  "dependencies": {
    "@svgedit/svgcanvas": "7.4.1",
    "browser-fs-access": "0.38.0",
    "clipper-lib": "6.4.2",
    "culori": "^4.0.2",
    "i18next": "25.7.4",
    "imagetracerjs": "^1.2.6",
    "paper": "^0.12.18",
    "spiro": "^3.0.1",
    "svgpath": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-dynamic-import-vars": "2.1.5",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "jsdom": "^27.4.0",
    "lz-string": "^1.5.0",
    "neostandard": "^0.14.1",
    "nyc": "17.1.0",
    "rimraf": "6.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.55.1"
  }
}
